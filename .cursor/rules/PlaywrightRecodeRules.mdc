## 六、完整转换示例

### 录制脚本（输入）

```python
page.goto("https://aixmy.miaobi.cn/#/home/profile")
page.get_by_role("button", name="开始上课").click()
page.locator(".work-item > .work-thumbnail").first.click()
page.get_by_role("button", name="启动课件，开始上课").click()
page.get_by_role("button", name="自动生成房间号").click()
page.wait_for_timeout(1000)
page.get_by_role("button", name="立即进入").click()
page.wait_for_timeout(5000)
page.frame_locator("iframe").get_by_text("文生图").click()
page.frame_locator("iframe").locator(".message-input-container-h5-center [contenteditable='true']").fill("老虎")
page.frame_locator("iframe").locator(".message-input-button-send-btn").click()
```

### 转换结果

**`pages/modules/aixmy/aixmy_page.py`（pages 层）**

```python
import re
from pages.base_page import BasePage
from utils.element import Element
from config.config import BASE_URL


class AixmyPage(BasePage):

    START_CLASS_BUTTON = Element("role", ("button", "开始上课"), desc="开始上课按钮")
    FIRST_WORK_THUMBNAIL = Element("css", ".work-item > .work-thumbnail", desc="第一个课件缩略图", first=True)
    LAUNCH_COURSEWARE_BUTTON = Element("role", ("button", "启动课件，开始上课"), desc="启动课件按钮")
    AUTO_ROOM_NUMBER_BUTTON = Element("role", ("button", "自动生成房间号"), desc="自动生成房间号按钮")
    ENTER_ROOM_BUTTON = Element("role", ("button", "立即进入"), desc="立即进入按钮")

    WENTU_TOOL = Element("text", "文生图", exact=True, desc="文生图工具入口",
                         filter_params={"has_text": re.compile(r"^文生图$")}, first=True)
    EDITOR_INPUT = Element("css", ".message-input-container-h5-center [contenteditable='true']", desc="提示词输入框")
    SEND_BUTTON = Element("css", ".message-input-button-send-btn", desc="发送按钮")
    REGENERATE_BUTTON = Element("text", "重新生成", desc="重新生成按钮")

    CLASSROOM_IFRAME = "iframe"   # iframe selector — 普通字符串，不用 Element

    def __init__(self, page):
        super().__init__(page)

    def open(self):
        self.navigate(BASE_URL)

    def click_start_class(self):
        self.click(self.START_CLASS_BUTTON)

    def click_first_work(self):
        self.click(self.FIRST_WORK_THUMBNAIL)

    def launch_courseware(self):
        self.click(self.LAUNCH_COURSEWARE_BUTTON)
        self.click(self.AUTO_ROOM_NUMBER_BUTTON)
        self.page.wait_for_timeout(1000)
        self.click(self.ENTER_ROOM_BUTTON)
        self.page.wait_for_timeout(5000)

    def get_classroom_frame(self):
        return self.frame(self.CLASSROOM_IFRAME)

    def send_wentu_prompt(self, prompt_text: str):
        classroom = self.get_classroom_frame()
        classroom.click(self.WENTU_TOOL)
        self.page.wait_for_timeout(1000)
        classroom.fill(self.EDITOR_INPUT, prompt_text)
        classroom.click(self.SEND_BUTTON)
```

**`tests/aixmy/test_aixmy.py`（tests 层）**

```python
import allure
from playwright.sync_api import Page
from pages.modules.aixmy.aixmy_page import AixmyPage
from utils.data_loader import DataLoader
from utils.assertion import Assertion

assertion = Assertion("TestAixmy")


@allure.feature("Aixmy 平台")
class TestAixmy:

    @allure.story("文生图")
    @allure.title("进入课堂后使用文生图功能")
    @allure.severity(allure.severity_level.CRITICAL)
    def test_wentu_in_classroom(self, authenticated_page: Page, end_class):
        data = DataLoader.get_test_data("aixmy/aixmy_data.yaml", "wentu_test")
        aixmy_page = AixmyPage(authenticated_page)

        aixmy_page.open()
        aixmy_page.click_start_class()
        aixmy_page.click_first_work()
        aixmy_page.launch_courseware()
        end_class(aixmy_page)

        aixmy_page.send_wentu_prompt(data["prompt_text"])

        classroom = aixmy_page.get_classroom_frame()
        classroom.wait_for_selector(aixmy_page.REGENERATE_BUTTON, timeout=60000)
        assertion.assert_is_display(classroom, aixmy_page.REGENERATE_BUTTON, "文生图生成完成，重新生成按钮可见")
```

**`test_data/aixmy/aixmy_data.yaml`（data 层）**

```yaml
wentu_test:
  prompt_text: "老虎"
```

