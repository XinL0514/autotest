# Business auth credentials for local-only use.
# Copy this file to .env.local and fill in real values.

AUTOTEST_AUTH_USERNAME="your_username"
AUTOTEST_AUTH_PASSWORD="your_password"

# Token injection mode (optional, takes priority over username/password):
# Set AUTOTEST_AUTH_USER_JSON to the full JSON object stored in localStorage key 'user'.
# Get it from DevTools → Application → Local Storage → https://aixmy.miaobi.cn → user
# Example:
# AUTOTEST_AUTH_USER_JSON='{"id":13,"token":"Bearer eyJ...","orgId":4,"type":"teacher"}'

# Optional:
# AUTOTEST_AUTH_TTL_SECONDS=3600
# AUTOTEST_AUTH_VALIDATE=0
