{
    // VSCode Debug 配置文件
    // 使用方法：在测试文件中打断点，按 F5 或点击"运行和调试"
    "version": "0.2.0",
    "configurations": [
        {
            // 配置1: Pytest Debug - 调试当前文件
            "name": "Pytest: Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v",
                "-s"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.local",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            // 配置2: Pytest Debug - 调试当前测试函数
            "name": "Pytest: Debug Current Test",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}::${selectedText}",
                "-v",
                "-s"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.local",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            // 配置3: Pytest Debug - 调试所有测试
            "name": "Pytest: Debug All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/",
                "-v",
                "-s"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.local",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            // 配置4: Python File Debug - 直接运行 Python 文件（不推荐用于测试）
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.local",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            // 配置5: Pytest Debug - 调试用药记录测试（示例）
            "name": "Pytest: Debug MAR Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/mar/",
                "-v",
                "-s"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.local",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            // 配置6: Playwright Codegen - 录制脚本（使用当前 BASE_URL）
            "name": "Record: Playwright Codegen",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/record.py",
            "args": [
                "--platform",
                "--business-auth"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env.local",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
